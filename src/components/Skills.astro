---
import { skills } from '../data/site';
import { type Lang, useT } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const run = skills.map((s) => s.area[lang]);
---

<section id="habilidades" class="skills scene" data-section data-title={t('sec.skills')} data-theme="light">
  <div class="wrap skills__head">
    <h2 class="display skills__title" data-split>{t('sec.skills')}</h2>
    <p class="skills__lead" data-reveal>{t('skills.lead')}</p>
  </div>

  <!-- One band runs with the scroll; the details live in the list below -->
  <div class="band" aria-hidden="true" data-band>
    <span class="band__track" data-band-track>
      {
        [0, 1].map(() => (
          <span class="band__run">
            {run.map((txt) => (
              <>
                <span class="band__area">{txt}</span>
                <span class="band__sep">✕</span>
              </>
            ))}
          </span>
        ))
      }
    </span>
  </div>

  <ul class="wrap skills__list">
    {
      skills.map((s) => (
        <li class="skills__row" data-reveal-row>
          <details class="x-expand" data-expand>
            <summary class="skills__sum">
              <span class="skills__area">{s.area[lang]}</span>
              <span class="ann skills__count">{String(s.items.length).padStart(2, '0')}</span>
              <span class="skills__toggle" aria-hidden="true">+</span>
            </summary>
            <div class="x-expand__body">
              <ul class="skills__items">
                {s.items.map((it) => (
                  <li>{it[lang]}</li>
                ))}
              </ul>
            </div>
          </details>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .skills {
    --bg: var(--c-paper-2);
    padding-block: var(--sp-9) var(--sp-8);
    overflow: clip;
  }
  .skills__head {
    display: grid;
    gap: var(--sp-4);
    margin-bottom: var(--sp-7);
  }
  .skills__title {
    font-size: var(--fs-xl);
    font-weight: 400;
  }
  .skills__lead {
    color: var(--fg-muted);
    max-width: 52ch;
  }
  .band {
    padding-block: var(--sp-4);
    border-block: var(--thread-w) solid var(--c-thread-dark);
    white-space: nowrap;
    overflow: hidden;
  }
  .band__track {
    display: inline-flex;
    will-change: transform;
  }
  .band__run {
    display: inline-flex;
    align-items: baseline;
    gap: var(--sp-5);
    padding-right: var(--sp-5);
  }
  .band__area {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: 400;
    letter-spacing: var(--track-display);
    line-height: 1;
  }
  .band__area:nth-child(4n + 3) {
    font-style: italic;
    font-weight: 300;
    color: var(--c-denim-700);
  }
  .band__sep {
    font-family: var(--font-mono);
    font-size: var(--fs-mono-sm);
    color: var(--accent);
  }
  .skills__list {
    list-style: none;
    margin-top: var(--sp-7);
  }
  .skills__row {
    border-bottom: 1px solid var(--line);
  }
  .skills__sum {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 2rem;
    gap: var(--sp-4);
    align-items: baseline;
    padding-block: var(--sp-4);
  }
  .skills__area {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    line-height: 1.1;
  }
  .skills__toggle {
    justify-self: end;
    font-family: var(--font-mono);
    font-size: var(--fs-md);
    transition: transform var(--dur-base) var(--ease-out);
  }
  details[open] .skills__toggle {
    transform: rotate(45deg);
  }
  .skills__items {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    padding: 0 0 var(--sp-5);
    list-style: none;
  }
  .skills__items li {
    font-family: var(--font-mono);
    font-size: var(--fs-mono-sm);
    padding: 0.4em 0.85em;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--c-paper);
  }
</style>
