---
import { certs } from '../data/site';
import { getPhotos } from '../lib/photos';
import { type Lang, useT } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const total = getPhotos().length;
const pad = (n: number) => String(n).padStart(2, '0');
const done = certs.filter((c) => c.status === 'done').length;
const inProgress = certs.filter((c) => c.status === 'progress').length;
const certAnn = `CERT ${done} ✓ · ${inProgress} ▷`;
---

<section id="entrada" class="hero" data-section data-title={t('sec.intro')} data-theme="light" data-hero>
  <div class="hero__stage" data-hero-stage>
    <canvas class="hero__field" data-field="hero" aria-hidden="true"></canvas>
    <span class="hero__circle hero__circle--a" aria-hidden="true"></span>
    <span class="hero__circle hero__circle--b" aria-hidden="true"></span>
    <span class="hero__circle hero__circle--c" aria-hidden="true"></span>

    <h1 class="hero__title">
      <span class="sr-only">beautiful engineering. {t('hero.kicker')}</span>
      <span class="hero__l1" aria-hidden="true" data-hero-l1>
        {[...'BEAUTIFUL'].map((ch) => <span class="hero__ch">{ch}</span>)}
      </span>
      <span class="hero__l2" aria-hidden="true" data-hero-l2>
        {[...'engineering'].map((ch) => <span class="hero__ch">{ch}</span>)}
      </span>
    </h1>

    <p class="hero__name">
      <span class="hero__dim hero__dim--l" aria-hidden="true" data-hero-dim>
        <span class="ann hero__dim-ann">{t('hero.ann.diameter')}</span>
      </span>
      <span class="hero__name-txt" data-hero-fade>Mariano Villagómez</span>
      <span class="hero__dim hero__dim--r" aria-hidden="true" data-hero-dim>
        <span class="ann hero__dim-ann">{t('hero.ann.semester')}</span>
      </span>
    </p>

    <div class="hero__center">
      <span class="hero__ring" aria-hidden="true" data-hero-ring></span>
      <div class="hero__slot" data-photo-home></div>
      <p class="hero__photo-ann" aria-hidden="true" data-hero-fade>
        <span class="ann">{t('hero.ann.size')}<span class="hero__sem-m"> · {t('hero.ann.semester')}</span></span>
        <span class="ann">{certAnn}</span>
      </p>
    </div>

    <svg class="hero__thread" aria-hidden="true" data-hero-thread>
      <path data-hero-thread-path d=""></path>
    </svg>

    <div class="hero__foot" data-hero-fade>
      <div class="hero__meta">
        <p class="mono hero__areas">{t('hero.areas')}</p>
        <p class="ann hero__place">{t('hero.place')} · {t('hero.coords')}</p>
      </div>
      {
        total > 1 && (
          <div class="photo-ctrl" role="group" aria-label={t('photo.controls')}>
            <span class="mono photo-ctrl__count">
              {t('photo.counter')} <span data-photo-idx>01</span>/{pad(total)}
            </span>
            <button
              class="btn photo-ctrl__btn"
              type="button"
              data-photo-toggle
              data-label-pause={t('photo.pause')}
              data-label-resume={t('photo.resume')}
            >
              <span class="photo-ctrl__glyph" aria-hidden="true" data-photo-glyph>‖</span>
              <span data-photo-label>{t('photo.pause')}</span>
            </button>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .hero {
    --photo-w: clamp(5.375rem, 4.2rem + 3.2vw, 7.5rem);
    --photo-h: calc(var(--photo-w) * 9 / 7);
    --ring: calc(var(--photo-w) * 2.15);
    position: relative;
    z-index: var(--z-hero);
    color: var(--c-ink);
  }
  .hero__stage {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-rows: auto auto auto 1fr auto;
    padding: calc(var(--sp-8) + var(--sp-2)) var(--gutter) var(--sp-5);
    overflow: clip;
  }
  .hero__field {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 42%;
    pointer-events: none;
  }
  .hero__circle {
    position: absolute;
    border: 1px solid color-mix(in srgb, var(--c-denim-500) 24%, transparent);
    border-radius: 50%;
    pointer-events: none;
  }
  .hero__circle--a {
    width: min(35vw, 31rem);
    aspect-ratio: 1;
    left: 50%;
    top: 58%;
    transform: translate(-50%, -50%);
  }
  .hero__circle--b {
    width: 44vw;
    aspect-ratio: 1;
    left: -15vw;
    top: -26vw;
  }
  .hero__circle--c {
    width: 39vw;
    aspect-ratio: 1;
    right: -24vw;
    bottom: -20vw;
  }

  .hero__title {
    position: relative;
    font-family: var(--font-display);
    font-weight: 300;
    user-select: none;
    -webkit-user-select: none;
  }
  .hero__l1,
  .hero__l2 {
    display: flex;
    justify-content: space-between;
  }
  .hero__l1 {
    font-size: clamp(3.25rem, 1.2rem + 9.6vw, 10rem);
    line-height: 0.92;
    color: var(--c-denim-700);
  }
  .hero__l2 {
    padding-inline: 11%;
    margin-top: 0.12em;
    font-size: clamp(1.625rem, 0.9rem + 3.9vw, 4.5rem);
    font-style: italic;
    line-height: 1.05;
  }
  .hero__ch {
    display: inline-block;
  }

  /* Name between dimension arrows (the common thread) */
  .hero__name {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.6rem;
    margin: clamp(1rem, 3.2vh, 2.25rem) calc(-1 * var(--gutter)) 0;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: clamp(0.625rem, 0.52rem + 0.42vw, 0.9375rem);
    letter-spacing: 0.5em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .hero__name-txt {
    margin-right: -0.5em;
  }
  .hero__dim {
    position: relative;
    height: var(--thread-w);
    background: var(--c-thread-dark);
  }
  .hero__dim::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 7px;
    height: 7px;
    border-top: var(--thread-w) solid var(--c-thread-dark);
    border-right: var(--thread-w) solid var(--c-thread-dark);
  }
  .hero__dim--l {
    transform-origin: right center;
  }
  .hero__dim--l::after {
    right: 0;
    transform: translateY(-50%) rotate(45deg);
  }
  .hero__dim--r {
    transform-origin: left center;
  }
  .hero__dim--r::after {
    left: 0;
    transform: translateY(-50%) rotate(-135deg);
  }
  .hero__dim-ann {
    position: absolute;
    bottom: 0.9rem;
    letter-spacing: 0.06em;
    text-transform: none;
    font-weight: 400;
  }
  .hero__dim--l .hero__dim-ann {
    left: 14vw;
  }
  .hero__dim--r .hero__dim-ann {
    right: 14vw;
  }

  .hero__center {
    position: relative;
    display: grid;
    place-items: center;
    min-height: calc(var(--ring) + 2rem);
  }
  .hero__ring {
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--ring);
    height: var(--ring);
    border: var(--thread-w) solid var(--c-thread-dark);
    border-radius: 50%;
    translate: -50% -50%;
  }
  .hero__slot {
    position: relative;
    width: var(--photo-w);
    height: var(--photo-h);
  }
  .hero__photo-ann {
    position: absolute;
    left: calc(50% + var(--ring) / 2 + 1.25rem);
    top: calc(50% - var(--photo-h) / 2 + 0.75rem);
    display: grid;
    gap: 0.35rem;
  }
  .hero__sem-m {
    display: none;
  }

  .hero__thread {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    fill: none;
    stroke: var(--c-thread-dark);
    stroke-width: var(--thread-w);
    stroke-linecap: round;
  }

  .hero__foot {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: var(--sp-5);
  }
  .hero__meta {
    display: grid;
    gap: 0.4rem;
    min-width: 0;
  }
  .hero__areas {
    font-size: var(--fs-mono);
    letter-spacing: 0.04em;
  }
  .hero__place {
    white-space: normal;
  }
  .photo-ctrl {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    flex-shrink: 0;
  }
  .photo-ctrl__count {
    font-size: var(--fs-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
  }
  .photo-ctrl__btn {
    font-size: var(--fs-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding-inline: 1em;
  }
  .photo-ctrl__glyph {
    display: inline-block;
    width: 1em;
    text-align: center;
  }

  @media (max-width: 767px) {
    .hero {
      --photo-w: 5.375rem;
    }
    .hero__name {
      letter-spacing: 0.28em;
      gap: 0.5rem;
    }
    .hero__name-txt {
      margin-right: -0.28em;
    }
    .hero__dim-ann {
      display: none;
    }
    .hero__photo-ann {
      left: 50%;
      top: calc(3rem + var(--photo-h) / 2 + var(--ring) / 2 + 0.75rem);
      translate: -50% 0;
      justify-items: center;
    }
    .hero__center {
      min-height: calc(var(--ring) + 6.5rem);
      align-content: start;
      padding-top: 3rem;
    }
    .hero__ring {
      top: calc(3rem + var(--photo-h) / 2);
    }
    .hero__sem-m {
      display: inline;
    }
    .hero__foot {
      flex-direction: column;
      justify-content: flex-end;
      align-items: stretch;
      align-self: end;
      gap: var(--sp-4);
    }
    .photo-ctrl {
      justify-content: space-between;
    }
    .hero__circle--a {
      width: 80vw;
      top: 50%;
    }
  }
</style>
