---
import Letters from './Letters.astro';
import { contact } from '../data/site';
import { type Lang, useT } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const year = new Date().getFullYear();
---

<section id="contacto" class="contact scene scene--dark" data-section data-title={t('sec.contact')} data-theme="dark">
  <div class="wrap contact__wrap">
    <p class="label" data-reveal-label>
      <span class="label__num">07</span><span>{t('sec.contact')}</span><span class="label__stitch"></span>
    </p>

    <h2 class="contact__title" data-repel>
      <span class="contact__l1"><Letters text={t('contact.title1')} /></span>
      <span class="contact__l2"><Letters text={t('contact.title2')} /></span>
    </h2>

    <p class="contact__lead">{t('contact.lead')}</p>

    <ul class="contact__links">
      <li>
        <span class="mono contact__k">{t('contact.email')}</span>
        <a class="contact__v" href={`mailto:${contact.email}`}>{contact.email}</a>
      </li>
      <li>
        <span class="mono contact__k">{t('contact.linkedin')}</span>
        <a class="contact__v" href={contact.linkedin} rel="noopener me" target="_blank">{contact.linkedinLabel} <span aria-hidden="true">↗</span></a>
      </li>
    </ul>
  </div>

  <footer class="wrap contact__foot mono">
    <span>© {year} {t('footer.rights')}</span>
    <span>beautiful engineering</span>
  </footer>
</section>

<style>
  .contact {
    --bg: var(--c-ink);
  }
  .contact__wrap {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--sp-6);
    padding-block: var(--sp-9) var(--sp-7);
  }
  .contact__title {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-size: clamp(3.25rem, 1rem + 10vw, 11rem);
    line-height: 0.86;
    letter-spacing: -0.04em;
    font-weight: 560;
    user-select: none;
    -webkit-user-select: none;
  }
  .contact__l2 {
    font-style: italic;
    font-weight: 300;
    color: var(--c-denim-300);
    padding-left: 0.6em;
  }
  .contact__lead {
    font-size: var(--fs-lg);
    font-family: var(--font-display);
    font-weight: 380;
    color: var(--fg-muted);
    max-width: 30ch;
  }
  .contact__links {
    list-style: none;
    padding: 0;
    border-top: var(--stitch);
  }
  .contact__links li {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: var(--sp-4);
    align-items: baseline;
    padding-block: var(--sp-4);
    border-bottom: 1px solid var(--line);
  }
  .contact__k {
    font-size: var(--fs-xs);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--accent);
  }
  .contact__v {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    text-decoration: none;
    overflow-wrap: anywhere;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size var(--dur-base) var(--ease-out);
  }
  .contact__v:hover,
  .contact__v:focus-visible {
    background-size: 100% 1px;
  }
  .contact__foot {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-4);
    padding-block: var(--sp-5);
    font-size: var(--fs-xs);
    color: var(--fg-muted);
    border-top: 1px solid var(--line);
  }
  @media (max-width: 640px) {
    .contact__links li {
      grid-template-columns: 1fr;
      gap: var(--sp-1);
    }
  }
</style>
