---
import { contact } from '../data/site';
import { type Lang, useT } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const year = new Date().getFullYear();
---

<section id="contacto" class="contact scene scene--dark" data-section data-title={t('sec.contact')} data-theme="dark" data-contact>
  <canvas class="contact__field" data-field="contact" aria-hidden="true"></canvas>

  <div class="wrap contact__wrap">
    <h2 class="contact__title" data-split>
      <span class="contact__l1">{t('contact.title1')}</span>
      <span class="contact__l2">{t('contact.title2')}</span>
    </h2>

    <p class="contact__lead" data-reveal>{t('contact.lead')}</p>

    <ul class="contact__links">
      <li class="contact__email">
        <span class="ann contact__k">{t('contact.email')}</span>
        <a class="contact__v contact__v--big" href={`mailto:${contact.email}`}>{contact.email}</a>
        <span class="contact__thread" aria-hidden="true" data-contact-thread></span>
      </li>
      <li>
        <span class="ann contact__k">{t('contact.linkedin')}</span>
        <a class="contact__v" href={contact.linkedin} rel="noopener me" target="_blank">{contact.linkedinLabel} <span aria-hidden="true">↗</span></a>
      </li>
    </ul>
  </div>

  <footer class="wrap contact__foot mono">
    <span>© {year} {t('footer.rights')}</span>
    <span>beautiful engineering</span>
  </footer>
</section>

<style>
  .contact {
    --bg: var(--c-denim-900);
    overflow: clip;
  }
  .contact__field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .contact__wrap {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--sp-6);
    padding-block: var(--sp-9) var(--sp-7);
  }
  .contact__title {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-size: clamp(3rem, 1rem + 7vw, 8rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
    font-weight: 400;
  }
  .contact__l2 {
    font-style: italic;
    font-weight: 300;
    color: var(--c-denim-300);
  }
  .contact__lead {
    font-size: var(--fs-md);
    color: var(--fg-muted);
    max-width: 44ch;
  }
  .contact__links {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--sp-6);
    margin-top: var(--sp-5);
  }
  .contact__links li {
    position: relative;
    display: grid;
    gap: var(--sp-2);
  }
  .contact__k {
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }
  .contact__v {
    width: fit-content;
    font-family: var(--font-mono);
    font-size: var(--fs-mono-sm);
    letter-spacing: 0.03em;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .contact__v--big {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.6rem, 0.6rem + 4.6vw, 4.75rem);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  @media (hover: hover) and (pointer: fine) {
    .contact__v:hover {
      text-decoration: underline;
    }
  }
  /* All the lines of the field end in this single thread */
  .contact__thread {
    display: block;
    width: 100vw;
    height: var(--thread-w);
    margin-left: calc(-1 * var(--gutter));
    background: var(--c-thread);
    transform-origin: left center;
  }
  .contact__foot {
    position: relative;
    z-index: var(--z-content);
    display: flex;
    justify-content: space-between;
    gap: var(--sp-4);
    padding-block: var(--sp-5);
    font-size: var(--fs-mono);
    color: var(--fg-muted);
    border-top: 1px solid var(--line);
  }
</style>
