---
/**
 * The passport photo: a single element for the whole page.
 * Its DOM home is the dock in About; the intro script places it in the
 * Intro slot and moves it back while scrolling (never two copies).
 */
import { getPhotos } from '../lib/photos';
import { type Lang, useT } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const photos = getPhotos();
---

<figure class="photo" data-photo data-count={photos.length}>
  <span class="photo__frame" aria-hidden="true"></span>
  <span class="photo__stack">
    {
      photos.length > 0 ? (
        photos.map((p, i) => (
          <img
            class:list={['photo__img', { 'is-active': i === 0 }]}
            src={p.src}
            alt={p.alt ? p.alt[lang] : `${t('photo.alt')} ${i + 1}`}
            aria-hidden={i === 0 ? undefined : 'true'}
            width="700"
            height="900"
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding="async"
            data-photo-item
          />
        ))
      ) : (
        <span class="photo__ph" role="img" aria-label={t('photo.placeholder')}>
          <span class="photo__ph-head"></span>
          <span class="photo__ph-body"></span>
        </span>
      )
    }
  </span>
</figure>

<style>
  /*
    While it travels, the photo animates width/height (not scale) so its 2px
    thread frame keeps its weight. It is absolutely positioned and contained,
    so the layout work stays inside this one element.
  */
  .photo {
    position: absolute;
    inset: 0;
    margin: 0;
    transform-origin: 0 0;
    contain: layout style;
  }
  /* The thread frame travels with the photo */
  .photo__frame {
    position: absolute;
    inset: -10px;
    border: var(--thread-w) solid var(--c-thread-dark);
    border-radius: 14px;
    opacity: 1;
    pointer-events: none;
  }
  .photo__stack {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
    background: var(--c-denim-100);
    outline: 1px solid var(--c-ink);
  }
  .photo__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity var(--dur-slow) var(--ease-out);
  }
  .photo__img.is-active {
    opacity: 1;
  }
  .photo__ph {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--c-denim-100), var(--c-denim-300));
  }
  .photo__ph-head,
  .photo__ph-body {
    position: absolute;
    left: 50%;
    border-radius: 50%;
    transform: translateX(-50%);
    background: color-mix(in srgb, var(--c-denim-700) 50%, transparent);
  }
  .photo__ph-head {
    top: 19%;
    width: 34%;
    height: 33%;
  }
  .photo__ph-body {
    top: 62%;
    width: 80%;
    height: 60%;
  }
</style>
