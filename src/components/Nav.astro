---
import { type Lang, useT, homePath } from '../i18n/ui';
interface Props {
  lang: Lang;
  altHref: string;
  /** On inner pages the links point back to the home page. */
  inner?: boolean;
}
const { lang, altHref, inner = false } = Astro.props;
const t = useT(lang);
const base = inner ? homePath(lang) : '';
const sections = [
  { id: 'entrada', key: 'sec.intro' },
  { id: 'sobre-mi', key: 'sec.about' },
  { id: 'proyectos', key: 'sec.projects' },
  { id: 'ruta', key: 'sec.route' },
  { id: 'certificaciones', key: 'sec.certs' },
  { id: 'habilidades', key: 'sec.skills' },
  { id: 'contacto', key: 'sec.contact' },
] as const;
const total = String(sections.length).padStart(2, '0');
---

<header class="nav" data-nav>
  <a class="nav__logo nav__item" href={homePath(lang)} data-nav-item>
    <span>beautiful</span> <em>engineering</em>
  </a>
  <p class="nav__where nav__item" aria-hidden="true" data-nav-item>
    <span data-nav-num>01</span><span class="nav__sep">/{total}</span>
    <span class="nav__title" data-nav-title>{t('sec.intro')}</span>
  </p>
  <div class="nav__right nav__item" data-nav-item>
    <a class="nav__lang" href={altHref} hreflang={lang === 'es' ? 'en' : 'es'} lang={lang === 'es' ? 'en' : 'es'}>
      {t('nav.langShort')}<span class="sr-only"> · {t('nav.lang')}</span>
    </a>
    <button class="nav__menu" type="button" aria-expanded="false" aria-controls="menu" data-menu-open>
      {t('nav.menu')}
    </button>
  </div>
</header>

<div class="menu scene scene--dark" id="menu" data-menu hidden>
  <nav class="menu__nav" aria-label={t('nav.primary')}>
    <ol>
      {
        sections.map((s, i) => (
          <li>
            <a href={`${base}#${s.id}`} data-menu-link>
              <span class="menu__num">{String(i + 1).padStart(2, '0')}</span>
              <span class="menu__txt">{t(s.key)}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
  <button class="menu__close nav__menu" type="button" data-menu-close>{t('nav.close')}</button>
</div>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--z-nav);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--sp-4);
    padding: var(--sp-4) var(--gutter);
    pointer-events: none;
  }
  .nav > * {
    pointer-events: auto;
  }
  :global(.js:not(.is-loaded)) .nav {
    visibility: hidden;
  }
  /* Translucent bar, only once the page has scrolled past a full-bleed moment */
  .nav::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: color-mix(in srgb, var(--c-paper) 86%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    opacity: 0;
    transition:
      opacity var(--dur-base) var(--ease-out),
      background-color var(--dur-base) var(--ease-out);
  }
  .nav.is-scrolled::before {
    opacity: 1;
  }
  .nav.is-bar-dark::before {
    background: color-mix(in srgb, var(--c-denim-900) 82%, transparent);
  }
  /* Each item picks its own color from what sits behind it */
  .nav__item {
    color: var(--c-ink);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .nav__item.is-dark {
    color: var(--c-paper);
  }
  .nav__logo {
    justify-self: start;
    display: inline-flex;
    gap: 0.28em;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
    line-height: 1;
  }
  .nav__logo em {
    font-weight: 300;
  }
  .nav__where {
    display: flex;
    align-items: baseline;
    gap: var(--sp-2);
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    overflow: hidden;
  }
  .nav__sep {
    opacity: 0.55;
  }
  .nav__title {
    display: inline-block;
    margin-left: var(--sp-2);
  }
  .nav__right {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: var(--sp-4);
  }
  .nav__lang,
  .nav__menu {
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    font-weight: 500;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    text-decoration: none;
    padding: var(--sp-2) 0;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .nav__menu {
    padding-inline: var(--sp-4);
    border: 1px solid currentColor;
    border-radius: 999px;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .nav__menu:active {
    transform: scale(0.97);
  }
  @media (max-width: 767px) {
    .nav {
      grid-template-columns: 1fr auto;
    }
    .nav__where {
      display: none;
    }
    .nav__logo {
      font-size: 1rem;
    }
  }

  .menu {
    position: fixed;
    inset: 0;
    z-index: calc(var(--z-nav) + 1);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--sp-8) var(--gutter);
  }
  .menu[hidden] {
    display: none;
  }
  .menu ol {
    list-style: none;
    padding: 0;
  }
  .menu a {
    display: flex;
    align-items: baseline;
    gap: var(--sp-4);
    padding-block: 0.08em;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1.2rem + 4.5vw, 5.5rem);
    line-height: 1.02;
    letter-spacing: var(--track-display);
  }
  .menu a:hover .menu__txt,
  .menu a:focus-visible .menu__txt {
    font-style: italic;
    font-weight: 300;
    color: var(--c-denim-300);
  }
  .menu__num {
    font-family: var(--font-mono);
    font-size: var(--fs-mono-sm);
    color: var(--c-thread);
    letter-spacing: 0.06em;
  }
  .menu__close {
    position: absolute;
    top: var(--sp-4);
    right: var(--gutter);
    color: var(--c-paper);
  }
</style>
