---
import { route } from '../data/site';
import { type Lang, useT } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const statusKey = { done: 'status.done', progress: 'status.progress', next: 'status.next', later: 'status.later' } as const;
---

<section id="ruta" class="route scene scene--dark" data-section data-title={t('sec.route')} data-theme="dark">
  <div class="wrap route__wrap">
    <div class="route__head">
      <p class="label" data-reveal-label>
        <span class="label__num">04</span><span>{t('sec.route')}</span><span class="label__stitch"></span>
      </p>
      <h2 class="display" data-reveal-lines>
        <span class="reveal-line"><span>{t('sec.route').split(' ')[0]}</span></span>
        <span class="reveal-line"><span><em>{t('sec.route').split(' ').slice(1).join(' ')}</em></span></span>
      </h2>
      <p class="route__lead">{t('route.lead')}</p>
    </div>

    <div class="route__track" data-route>
    <span class="route__thread" aria-hidden="true"><span data-route-thread></span></span>
    <ol class="route__list">
      {
        route.map((step, i) => (
          <li class:list={['route__step', `is-${step.status}`]} data-route-step>
            <span class="route__node" aria-hidden="true" />
            <details class="x-expand route__item" data-expand open={i === 0}>
              <summary>
                <span class="route__status mono">{t(statusKey[step.status])}</span>
                <span class="route__title">{step.title[lang]}</span>
                <span class="route__toggle" aria-hidden="true">+</span>
              </summary>
              <div class="x-expand__body">
                <ul>
                  {step.items.map((it) => (
                    <li>{it[lang]}</li>
                  ))}
                </ul>
              </div>
            </details>
          </li>
        ))
      }
    </ol>
    </div>
  </div>
</section>

<style>
  .route {
    --bg: var(--c-denim-800);
  }
  .route__wrap {
    padding-block: var(--sp-9);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    gap: var(--sp-8);
    align-items: start;
  }
  .route__head {
    position: sticky;
    top: var(--sp-9);
    display: grid;
    gap: var(--sp-6);
  }
  .route__head em {
    color: var(--c-denim-300);
  }
  .route__lead {
    color: var(--fg-muted);
    max-width: 32ch;
  }
  .route__track {
    position: relative;
  }
  .route__list {
    list-style: none;
    padding: var(--sp-4) 0 var(--sp-4) var(--sp-7);
    display: grid;
    gap: var(--sp-7);
  }
  .route__thread {
    position: absolute;
    left: 11px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: color-mix(in srgb, var(--c-paper) 10%, transparent);
  }
  .route__thread span {
    display: block;
    width: 100%;
    height: 100%;
    background: repeating-linear-gradient(180deg, var(--c-thread) 0 10px, transparent 10px 16px);
    transform-origin: top center;
  }
  .route__step {
    position: relative;
  }
  .route__node {
    position: absolute;
    left: calc(-1 * var(--sp-7) + 4px);
    top: 0.55em;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 2px solid var(--c-thread);
    background: var(--c-denim-800);
  }
  .route__step.is-done .route__node,
  .route__step.is-progress .route__node {
    background: var(--c-thread);
  }
  .route__step.is-progress .route__node {
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--c-thread) 22%, transparent);
  }
  .route__item summary {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--sp-2) var(--sp-4);
    align-items: baseline;
    padding-bottom: var(--sp-4);
    border-bottom: 1px solid var(--line);
  }
  .route__status {
    grid-column: 1 / -1;
    font-size: var(--fs-xs);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--accent);
  }
  .route__title {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 500;
    line-height: 1.1;
  }
  .route__toggle {
    font-family: var(--font-mono);
    font-size: var(--fs-lg);
    transition: transform var(--dur-base) var(--ease-out);
  }
  .route__item[open] .route__toggle {
    transform: rotate(45deg);
  }
  .route__item ul {
    display: grid;
    gap: var(--sp-2);
    padding: var(--sp-4) 0 0 1.1em;
    color: var(--fg-muted);
  }
  .route__item ul li::marker {
    color: var(--accent);
  }
  .route__step.is-later {
    opacity: 0.78;
  }
  @media (max-width: 900px) {
    .route__wrap {
      grid-template-columns: 1fr;
      gap: var(--sp-7);
    }
    .route__head {
      position: static;
    }
  }
</style>
