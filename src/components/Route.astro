---
import { route } from '../data/site';
import { type Lang, useT } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const statusKey = { done: 'status.done', progress: 'status.progress', next: 'status.next', later: 'status.later' } as const;
const n = route.length;
---

<section id="ruta" class="route scene" data-section data-title={t('sec.route')} data-theme="light">
  <div class="wrap route__wrap">
    <header class="route__head">
      <h2 class="display route__title" data-split>{t('sec.route')}</h2>
      <p class="route__lead" data-reveal>{t('route.lead')}</p>
    </header>

    <div class="route__track" data-route>
      <svg class="route__signal" aria-hidden="true" data-route-svg>
        <path class="route__path route__path--done" data-route-done d=""></path>
        <path class="route__path route__path--future" data-route-future d=""></path>
      </svg>
      <ol class="route__list" style={`--n: ${n}`}>
        {
          route.map((step, i) => (
            <li class:list={['route__step', `is-${step.status}`]} style={`--col: ${i + 1}; --row: ${n - i}`} data-route-step>
              <span class="route__node" aria-hidden="true" data-route-node />
              <details class="x-expand route__item" data-expand>
                <summary>
                  <span class="route__name">{step.title[lang]}</span>
                  <span class="ann route__status">{t(statusKey[step.status])}</span>
                  <span class="route__toggle" aria-hidden="true">+</span>
                </summary>
                <div class="x-expand__body">
                  <ul>
                    {step.items.map((it) => (
                      <li>{it[lang]}</li>
                    ))}
                  </ul>
                </div>
              </details>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .route {
    --bg: var(--c-paper);
  }
  .route__wrap {
    padding-block: var(--sp-9);
    display: grid;
    gap: var(--sp-8);
  }
  .route__head {
    display: grid;
    gap: var(--sp-4);
  }
  .route__title {
    font-size: var(--fs-xl);
    font-weight: 400;
  }
  .route__lead {
    color: var(--fg-muted);
    max-width: 52ch;
  }
  .route__track {
    position: relative;
  }
  .route__signal {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    fill: none;
  }
  .route__path {
    stroke: var(--c-thread-dark);
    stroke-width: var(--thread-w);
    stroke-linejoin: round;
  }
  .route__path--future {
    stroke-dasharray: 6 8;
  }
  .route__list {
    position: relative;
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    grid-auto-rows: auto;
    row-gap: var(--sp-6);
    column-gap: var(--sp-5);
  }
  .route__step {
    position: relative;
    grid-column: var(--col);
    grid-row: var(--row);
    padding-left: var(--sp-6);
  }
  .route__node {
    position: absolute;
    left: -6px;
    bottom: -6px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: var(--thread-w) solid var(--c-thread-dark);
    background: var(--c-paper);
  }
  .route__step.is-done .route__node,
  .route__step.is-progress .route__node {
    background: var(--c-thread-dark);
  }
  .route__item summary {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--sp-2) var(--sp-3);
    align-items: baseline;
    padding-bottom: var(--sp-4);
  }
  .route__name {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 400;
    line-height: 1.1;
  }
  .route__status {
    grid-row: 2;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .route__toggle {
    grid-row: 1;
    grid-column: 2;
    font-family: var(--font-mono);
    font-size: var(--fs-md);
    transition: transform var(--dur-base) var(--ease-out);
  }
  .route__item[open] .route__toggle {
    transform: rotate(45deg);
  }
  .route__item ul {
    display: grid;
    gap: var(--sp-2);
    padding: 0 0 var(--sp-4) 1.1em;
    color: var(--fg-muted);
    font-size: var(--fs-sm);
  }
  .route__item ul li::marker {
    color: var(--accent);
  }
  .route__step.is-later .route__name,
  .route__step.is-later .route__status {
    color: var(--fg-muted);
  }
  /* Narrow screens: a vertical thread with nodes */
  @media (max-width: 899px) {
    .route__list {
      grid-template-columns: 1fr;
      row-gap: var(--sp-5);
      padding-left: var(--sp-5);
    }
    .route__step {
      grid-column: 1;
      grid-row: auto;
      padding-left: var(--sp-4);
    }
    .route__node {
      left: calc(-1 * var(--sp-5) - 5px);
      top: 0.55em;
      bottom: auto;
    }
  }
</style>
