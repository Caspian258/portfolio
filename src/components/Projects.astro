---
import type { CollectionEntry } from 'astro:content';
import { type Lang, useT, projectPath } from '../i18n/ui';
import ProjectBody from './ProjectBody.astro';

interface Props {
  lang: Lang;
  projects: CollectionEntry<'proyectos'>[];
}
const { lang, projects } = Astro.props;
const t = useT(lang);
const count = String(projects.length).padStart(2, '0');
const areaLabel: Record<string, Record<Lang, string>> = {
  ciberseguridad: { es: 'Ciberseguridad', en: 'Cybersecurity' },
  mecatronica: { es: 'Mecatrónica', en: 'Mechatronics' },
  ot: { es: 'OT', en: 'OT' },
  ia: { es: 'IA', en: 'AI' },
  ml: { es: 'ML', en: 'ML' },
  llm: { es: 'LLMs', en: 'LLMs' },
  programacion: { es: 'Programación', en: 'Programming' },
};
---

<section id="proyectos" class="projects scene scene--dark" data-section data-title={t('sec.projects')} data-theme="dark">
  <div class="projects__stage" data-corridor>
    <div class="corridor" aria-hidden="true">
      <div class="corridor__room">
        <span class="corridor__wall corridor__wall--l"></span>
        <span class="corridor__wall corridor__wall--r"></span>
        <span class="corridor__wall corridor__wall--t"></span>
        <span class="corridor__wall corridor__wall--b"></span>
      </div>
      <span class="corridor__thread"></span>
    </div>

    <ol class="projects__items" data-corridor-items>
      <li class="projects__item projects__intro" data-corridor-item>
        <h2 class="display projects__title" data-split>
          {t('sec.projects')} <em>({count})</em>
        </h2>
        <p class="projects__lead">{t('projects.lead')}</p>
      </li>

      {
        projects.length === 0 && (
          <li class="projects__item projects__note" data-corridor-item>
            <p>{t('projects.empty')}</p>
          </li>
        )
      }

      {
        projects.map((p) => {
          const d = p.data[lang];
          const areas = p.data.areas.map((a) => areaLabel[a]?.[lang] ?? a).join(' · ');
          return (
            <li class="projects__item" data-corridor-item>
              <article class="card" aria-labelledby={`card-${p.id}`}>
                <header class="card__head">
                  <span class="ann card__code">
                    {p.data.codigo}
                    {areas && ` · ${areas}`}
                  </span>
                  {!p.data.aprobado && <span class="card__draft">{t('projects.draft')}</span>}
                </header>
                <h3 class="card__title" id={`card-${p.id}`}>
                  {d.titulo}
                </h3>
                <p class="card__sum">{d.resumen}</p>
                {p.data.metricas.length > 0 && (
                  <dl class="card__metrics">
                    {p.data.metricas.map((m) => (
                      <div>
                        <dt>{m[lang]}</dt>
                        <dd>{m.valor}</dd>
                      </div>
                    ))}
                  </dl>
                )}
                <footer class="card__foot">
                  <p class="mono card__stack">
                    <span class="sr-only">{t('projects.stack')}: </span>
                    {p.data.stack.join(' · ')}
                  </p>
                  <button class="btn" type="button" data-dialog-open={`dlg-${p.id}`} aria-haspopup="dialog">
                    {t('projects.detail')} <span class="btn__plus" aria-hidden="true">+</span>
                  </button>
                </footer>

                <dialog class="dlg scene scene--dark" data-lenis-prevent id={`dlg-${p.id}`} aria-labelledby={`dlg-title-${p.id}`} data-dialog>
                  <div class="dlg__inner">
                    <div class="dlg__bar">
                      <span class="label">
                        <span class="label__num">{p.data.codigo}</span>
                        <span>{t('sec.projects')}</span>
                      </span>
                      <button class="btn" type="button" data-dialog-close>
                        {t('projects.close')} <span aria-hidden="true">×</span>
                      </button>
                    </div>
                    <h3 class="display dlg__title" id={`dlg-title-${p.id}`}>
                      {d.titulo}
                    </h3>
                    <ProjectBody project={p} lang={lang} compact />
                    <p class="dlg__links">
                      <a class="btn" href={projectPath(lang, p.id)}>
                        {t('projects.page')} <span aria-hidden="true">→</span>
                      </a>
                      <a class="btn" href={p.data.repo} rel="noopener" target="_blank">
                        {t('projects.repo')} <span aria-hidden="true">↗</span>
                      </a>
                    </p>
                  </div>
                </dialog>
              </article>
            </li>
          );
        })
      }

      <li class="projects__item projects__note" data-corridor-item>
        <p>{t('projects.next')}</p>
      </li>
    </ol>

    <p class="ann projects__z" aria-hidden="true">z = <span data-corridor-z>−1200</span> → 0 mm</p>
  </div>
</section>

<style>
  .projects {
    overflow: clip;
  }
  .projects__stage {
    position: relative;
    min-height: 100svh;
    padding: calc(var(--sp-8) + var(--sp-4)) var(--gutter) var(--sp-8);
  }

  /* The perspective box: only in this section */
  .corridor {
    position: absolute;
    inset: 0;
    perspective: 700px;
    pointer-events: none;
    overflow: hidden;
  }
  .corridor__room {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }
  .corridor__wall {
    position: absolute;
    background-image:
      linear-gradient(color-mix(in srgb, var(--c-denim-300) 30%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--c-denim-300) 30%, transparent) 1px, transparent 1px);
    background-size: 160px 150px;
  }
  .corridor__wall--l,
  .corridor__wall--r {
    top: 0;
    width: 1600px;
    height: 100%;
  }
  .corridor__wall--l {
    left: 0;
    transform-origin: left center;
    transform: rotateY(90deg);
  }
  .corridor__wall--r {
    right: 0;
    transform-origin: right center;
    transform: rotateY(-90deg);
  }
  .corridor__wall--t,
  .corridor__wall--b {
    left: 0;
    width: 100%;
    height: 1600px;
  }
  .corridor__wall--t {
    top: 0;
    transform-origin: center top;
    transform: rotateX(-90deg);
  }
  .corridor__wall--b {
    bottom: 0;
    transform-origin: center bottom;
    transform: rotateX(90deg);
  }
  .corridor__thread {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: var(--thread-w);
    height: 26%;
    background: var(--c-thread);
    transform: translateX(-50%);
    transform-origin: bottom center;
  }

  .projects__items {
    position: relative;
    z-index: var(--z-content);
    list-style: none;
    padding: 0;
    display: grid;
    justify-items: center;
    gap: var(--sp-8);
  }
  .projects__item {
    width: min(42.5rem, 100%);
  }
  .projects__intro {
    display: grid;
    gap: var(--sp-5);
    text-align: center;
    justify-items: center;
  }
  .projects__title em {
    font-weight: 300;
    color: var(--c-denim-300);
  }
  .projects__lead {
    max-width: 40ch;
    color: var(--fg-muted);
  }
  .projects__note p {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    line-height: 1.3;
    color: var(--fg-muted);
    text-align: center;
    max-width: 30ch;
    margin-inline: auto;
  }
  .projects__z {
    position: absolute;
    left: var(--gutter);
    bottom: var(--sp-5);
    z-index: var(--z-content);
  }

  .card {
    display: grid;
    gap: var(--sp-5);
    padding: clamp(1.25rem, 0.8rem + 1.6vw, 2rem);
    background: var(--c-denim-800);
    border: 1px solid color-mix(in srgb, var(--c-denim-300) 45%, transparent);
    border-radius: var(--radius-s);
  }
  .card__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--sp-3);
  }
  .card__code {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    white-space: normal;
  }
  .card__draft {
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.3em 0.7em;
    border: 1px dashed var(--c-thread);
    color: var(--c-thread);
    border-radius: 999px;
    flex-shrink: 0;
  }
  .card__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.9rem, 1.2rem + 2.1vw, 3.25rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .card__sum {
    max-width: 52ch;
    color: var(--c-denim-300);
  }
  .card__metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--sp-4) var(--sp-5);
  }
  .card__metrics div {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--sp-2);
  }
  .card__metrics dd {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.75rem, 1.2rem + 1.4vw, 2.6rem);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .card__metrics dt {
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    color: var(--c-denim-300);
    line-height: 1.45;
  }
  .card__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--sp-4);
  }
  .card__stack {
    font-size: var(--fs-mono);
    color: var(--c-denim-300);
    letter-spacing: 0.04em;
  }

  /* Corridor mode (set by the script on wide screens with motion allowed) */
  .is-corridor .projects__stage {
    height: 100svh;
    padding: 0;
  }
  .is-corridor .projects__items {
    position: absolute;
    inset: 0;
    display: block;
    perspective: 700px;
  }
  .is-corridor .projects__item {
    position: absolute;
    left: 50%;
    top: 52%;
    width: min(42.5rem, 80vw);
    will-change: transform, opacity;
  }

  /* Project dialog */
  .dlg {
    position: fixed;
    inset: 0;
    width: min(64rem, 100vw - 2 * var(--gutter));
    max-height: calc(100svh - 2 * var(--gutter));
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: var(--radius-m);
    overflow: auto;
    overscroll-behavior: contain;
  }
  .dlg::backdrop {
    background: color-mix(in srgb, var(--c-ink) 70%, transparent);
  }
  .dlg__inner {
    padding: var(--sp-6);
    display: grid;
    gap: var(--sp-6);
  }
  .dlg__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--sp-4);
  }
  .dlg__title {
    font-size: var(--fs-xl);
  }
  .dlg__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }
  @media (max-width: 767px) {
    .corridor__room {
      display: none;
    }
    .corridor__thread,
    .projects__z {
      display: none;
    }
    .dlg__inner {
      padding: var(--sp-5);
    }
  }
</style>
