---
/**
 * Hueco dentro de un titular que revela una foto tipo pasaporte.
 * Al pasar el cursor se abre; con clic (o Enter) cambia a la siguiente foto.
 * Mientras no haya fotos, muestra espacios reservados numerados.
 */
import { photos } from '../data/site';
import { type Lang, useT } from '../i18n/ui';
interface Props { lang: Lang; start?: number }
const { lang, start = 0 } = Astro.props;
const t = useT(lang);
const ordered = [...photos.slice(start), ...photos.slice(0, start)];
---

<button class="slot" type="button" data-slot aria-label={t('photo.hint')} title={t('photo.hint')}>
  <span class="slot__frame" aria-hidden="true">
    {
      ordered.map((p, i) => (
        <span class:list={['slot__item', { 'is-active': i === 0 }]} data-slot-item>
          {p.src ? (
            <img src={p.src} alt={p.alt[lang]} width="350" height="450" loading="lazy" decoding="async" />
          ) : (
            <span class="slot__ph">
              <span class="slot__ph-head" />
              <span class="slot__ph-body" />
              <span class="slot__ph-txt">
                {t('photo.placeholder')} {String(photos.indexOf(p) + 1).padStart(2, '0')}
              </span>
            </span>
          )}
        </span>
      ))
    }
    <span class="slot__corner slot__corner--tl"></span>
    <span class="slot__corner slot__corner--br"></span>
  </span>
</button>

<style>
  .slot {
    --h: 0.78em;
    position: relative;
    display: inline-block;
    vertical-align: baseline;
    width: 0.62em;
    height: var(--h);
    margin-inline: 0.36em;
    transform: translateY(0.04em);
    transition: width var(--dur-slow) var(--ease-out);
    cursor: pointer;
  }
  .slot::before,
  .slot::after {
    content: '(';
    position: absolute;
    top: 50%;
    transform: translateY(-54%);
    font-style: normal;
    font-weight: 300;
    font-size: 1.05em;
    line-height: 1;
    color: currentColor;
  }
  .slot::before {
    right: 100%;
  }
  .slot::after {
    content: ')';
    left: 100%;
  }
  .slot:hover,
  .slot:focus-visible,
  .slot.is-open {
    width: 0.98em;
  }
  .slot__frame {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: var(--radius-s);
    background: var(--c-denim-100);
  }
  .slot__item {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(1.15);
    transition:
      opacity var(--dur-base) var(--ease-out),
      transform var(--dur-slow) var(--ease-out);
  }
  .slot__item.is-active {
    opacity: 1;
    transform: none;
  }
  .slot__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Espacio reservado: silueta neutra de foto de pasaporte */
  .slot__ph {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--c-denim-100), var(--c-denim-300));
  }
  .slot__item:nth-child(2) .slot__ph {
    background: linear-gradient(180deg, var(--c-paper-2), var(--c-denim-300));
  }
  .slot__item:nth-child(3) .slot__ph {
    background: linear-gradient(180deg, var(--c-denim-300), var(--c-denim-500));
  }
  .slot__item:nth-child(4) .slot__ph {
    background: linear-gradient(180deg, var(--c-paper), var(--c-denim-100));
  }
  .slot__ph-head {
    position: absolute;
    left: 50%;
    top: 24%;
    width: 34%;
    aspect-ratio: 0.8;
    border-radius: 50%;
    transform: translateX(-50%);
    background: color-mix(in srgb, var(--c-denim-700) 55%, transparent);
  }
  .slot__ph-body {
    position: absolute;
    left: 50%;
    bottom: -12%;
    width: 78%;
    height: 38%;
    border-radius: 50% 50% 0 0;
    transform: translateX(-50%);
    background: color-mix(in srgb, var(--c-denim-700) 55%, transparent);
  }
  .slot__ph-txt {
    position: absolute;
    left: 6%;
    top: 5%;
    font-family: var(--font-mono);
    font-style: normal;
    font-weight: 500;
    font-size: max(0.09em, 8px);
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--c-ink);
  }
  .slot__corner {
    position: absolute;
    width: 14%;
    aspect-ratio: 1;
    border-color: var(--c-ink);
    border-style: solid;
    opacity: 0.6;
  }
  .slot__corner--tl {
    top: 4%;
    right: 4%;
    border-width: 1px 1px 0 0;
  }
  .slot__corner--br {
    bottom: 4%;
    left: 4%;
    border-width: 0 0 1px 1px;
  }
  @media (prefers-reduced-motion: reduce) {
    .slot,
    .slot__item {
      transition: none;
    }
  }
</style>
